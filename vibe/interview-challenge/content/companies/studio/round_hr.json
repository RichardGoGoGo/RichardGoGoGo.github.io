    "gco_cycle": {
      "tag": "动机与稳定",
      "text": "项目可能跨多轮版本，你怎样判断自己是否适合持续参与？",
      "options": [
        {
          "id": "gco_cycle_b",
          "type": "bold",
          "text": "把制作、验证与维护的日常一起纳入选择。",
          "face": "probe",
          "line": "行，我问一个具体的。",
          "followup": {
            "text": "如果试玩反馈推翻了你喜欢的方案，你会怎么办？",
            "options": [
              {
                "id": "gco_cycle_p",
                "type": "partial",
                "delta": -2,
                "text": "先按负责人的意见改，下一轮再找机会解释原方案。",
                "face": "calm",
                "line": "改完才解释，意见不一致也没人知道。"
              },
              {
                "id": "gco_cycle_f",
                "type": "fail",
                "delta": -7,
                "text": "保持原方案的完整表达，比迎合零散反馈更重要。",
                "face": "frown",
                "line": "反馈再零散，也不能直接不理。"
              },
              {
                "id": "gco_cycle_h",
                "type": "hold",
                "delta": 9,
                "text": "先看反馈和目标对不对得上，再比较改和留的代价。",
                "face": "pleased",
                "line": "对，改不改都要有理由。"
              }
            ],
            "explain": "项目周期长不等于必须固守最初方案。选择工作和处理反馈，都应落到任务、目标、证据与协作条件。喜爱题材可以提供动力，但不能代替对制作、维护和改稿日常的了解；接受反馈也不等于无条件照做所有意见。"
          }
        },
        {
          "id": "gco_cycle_c",
          "type": "off",
          "delta": -3,
          "text": "只要主打游戏类型合口味，就能适应项目里的其他工作。",
          "face": "calm",
          "line": "题材合口味，不等于日常你能适应。"
        },
        {
          "id": "gco_cycle_a",
          "type": "safe",
          "delta": 3,
          "text": "先看项目阶段、自己的职责和反馈方式，再比偏好。",
          "face": "nod",
          "line": "嗯，先看日常再谈偏好。"
        }
      ],
      "explain": "项目周期长不等于必须固守最初方案。选择工作和处理反馈，都应落到任务、目标、证据与协作条件。喜爱题材可以提供动力，但不能代替对制作、维护和改稿日常的了解；接受反馈也不等于无条件照做所有意见。"
    }
  }
