                }
              ],
              "explain": "协调工作可以从一次排期、通知或材料核对讲起，说明自己怎样处理问题、结果怎样。团队的录用量可作背景，个人贡献则落在实际完成的任务上。"
            }
          },
          {
            "id": "hr3_intro_task_c",
            "type": "off",
            "delta": -3,
            "text": "先列协调过的人数，再用团队录用量证明自己的能力。",
            "face": "calm",
            "line": "人数多，不等于你定的。"
          }
        ],
        "explain": "协调工作可以从一次排期、通知或材料核对讲起，说明自己怎样处理问题、结果怎样。团队的录用量可作背景，个人贡献则落在实际完成的任务上。"
      }
    },
    {
      "id": "hr3_intro_learning",
      "pools": [
        "biz_intro"
      ],
      "priority": 60,
      "when": {
        "role": "hr"
      },
      "node": {
        "tag": "项目表达",
        "text": "请挑一件你从反馈中改进做法的事介绍自己。",
        "options": [
          {
            "id": "hr3_intro_learning_b",
            "type": "bold",
            "text": "先说一个被推翻的假设，再讲如何补证据。",
            "face": "probe",
            "line": "被推翻的是什么？",
            "followup": {
              "text": "假设改动只减少了流程遗漏，能说招聘质量提高了吗？",
              "options": [
                {
                  "id": "hr3_intro_learning_p",
                  "type": "partial",
                  "delta": 1,
                  "text": "只汇报遗漏减少了，招聘质量是否提高先不提。",
                  "face": "calm",
                  "line": "不夸大，可后面呢？"
                },
                {
                  "id": "hr3_intro_learning_f",
                  "type": "fail",
