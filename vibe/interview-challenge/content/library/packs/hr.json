  "skill_probes": {
    "hr3_probe_recruiting": {
      "tag": "专业",
      "text": "简历写了精通招聘流程。怎样保证多位评估者的评分可核对？",
      "options": [
        {
          "id": "hr3_probe_recruiting_h",
          "type": "hold",
          "delta": 9,
          "text": "按任务定锚点，独立记行为证据后再讨论。",
          "face": "pleased",
          "line": "嗯，判断顺序清楚。",
          "requires": {
            "skill_min": {
              "p3t_hr_basics": 3
            }
          }
        },
        {
          "id": "hr3_probe_recruiting_truth",
          "type": "partial",
          "delta": -1,
          "text": "这项未达到精通，会先核对事实并请有权人员复核。",
          "face": "nod",
          "line": "按真实水平说清就好。"
        },
        {
          "id": "hr3_probe_recruiting_wrong",
          "type": "fail",
          "delta": -4,
          "text": "已有工作模板，保持前后一致就能代替逐项核对。",
          "face": "frown",
          "line": "模板不能替代适用条件。"
        }
      ],
      "explain": "“精通”标签会触发对方法和边界的追问。真实水平不足时如实说明损失最少；自信地把模板当作判断依据扣分更多。专业判断仍需事实、规则与授权，不因熟悉名词就自动成立。"
    },
