{
  "id": "r1",
  "name": "业务一面",
  "company": "unicorn",
  "interviewer": {
    "art": "A4",
    "title": "运营负责人"
  },
  "scene": "S5",
  "hello": "我是跃迁的运营负责人。我们做 AI 写作助手，用户多是学生和刚工作的人。今天聊聊运营基本功和你的经历。",
  "_note": "独角兽运营一面：未来的直属负责人考基本功（留存、分层、渠道、看板、选题），再深挖简历第一段。追问最多 2 层。题目素材按 G7 资料概括，只作依据。开场、q3（分层、渠道）、反问在 library/packs/ops.json 的题池（pools）里，题位用 prefer 钉住原来的题。q1、q4、q5 的题（或它的备选题）用到了这家公司的产品（一键润色、写作），留在这里。",
  "flow": [
    {
      "slot": "intro",
      "dynamic": "pool",
      "pool": "biz_intro",
      "prefer": [
        "uo1_intro"
      ],
      "swap": false
    },
    {
      "slot": "q1",
      "node": "uo1_q_retention",
      "swap": true,
      "alternates": [
        "uo1_q_retention_def"
      ]
    },
    {
      "slot": "q2",
      "dynamic": "deep_dive_first",
      "swap": false,
      "_note": "深挖简历第一页排第 1 的那段经历；那段是夸大或含糊写法时，换成对应的追问"
    },
    {
      "slot": "q3",
      "dynamic": "pool",
      "pool": "ops_growth",
      "prefer": [
        "uo1_q_segment",
        "uo1_q_channel"
      ],
      "swap": true
    },
    {
      "slot": "q4",
      "dynamic": "skill_probe",
      "node": "uo1_q_dashboard",
      "swap": true,
      "alternates": [
        "uo1_q_title_test"
      ],
      "_note": "技能栏写了“精通新媒体文案写作”“精通活动策划与执行”“精通 A/B 测试设计”或“精通 SQL”时换成对应追问，否则问数据看板"
    },
    {
      "slot": "q5",
      "node": "uo1_q_topic",
      "swap": true,
      "alternates": [
        "uo1_q_priority"
      ]
    },
    {
      "slot": "reverse",
      "dynamic": "pool",
      "pool": "biz_reverse",
      "prefer": [
        "uo1_reverse"
      ],
      "swap": false
    }
  ],
  "nodes": {
    "uo1_q_retention": {
      "tag": "专业",
      "text": "我们新用户的次日留存一直在 25% 左右。给你一个月，你先从哪下手？",
      "options": [
        {
          "id": "uo1_rt_a",
          "type": "safe",
          "delta": 3,
          "text": "先按渠道拆开，再看新用户第一天在哪一步流失最多。",
          "face": "nod",
          "line": "嗯，先拆再说。"
        },
        {
          "id": "uo1_rt_b",
          "type": "bold",
          "text": "先找留下来的那批人，看看他们第一天都做了哪几件事。",
          "face": "probe",
          "line": "好，我给你一个发现。",
          "followup": {
            "text": "假设发现：第一天用过“一键润色”的人，次日留存是没用过的两倍。下一步？",
            "options": [
              {
                "id": "uo1_rt_b1",
                "type": "bold",
                "text": "先别急着推，可能是本来就想用的人，才会去点润色。",
                "face": "probe",
                "line": "那你怎么验证？",
                "followup": {
                  "text": "那你怎么确认，润色本身真能让人留下来？",
                  "options": [
                    {
                      "id": "uo1_rt_b1a",
                      "type": "hold",
                      "delta": 12,
                      "text": "新用户随机分两组，一组首页直接引导去润色，比两组的次日留存。",
                      "face": "pleased",
                      "line": "对，先确认因果，再放大。"
                    },
                    {
                      "id": "uo1_rt_b1b",
                      "type": "partial",
                      "delta": 2,
                      "text": "找用过和没用过的用户各聊几个，问他们为什么回来。",
                      "face": "nod",
                      "line": "听得到原因，证明不了。"
                    },
                    {
                      "id": "uo1_rt_b1c",
                      "type": "fail",
                      "delta": -9,
                      "text": "两倍的差距已经很大了，样本也有几万人，足够下结论。",
                      "face": "frown",
                      "line": "人多就能说明是因果？"
                    }
                  ]
                }
              },
              {
                "id": "uo1_rt_b2",
                "type": "partial",
                "delta": -2,
                "text": "那就在新手引导里强推润色，让每个新用户都先用一次。",
                "face": "calm",
                "line": "推了没效果呢？"
              },
              {
                "id": "uo1_rt_b3",
                "type": "fail",
                "delta": -7,
                "text": "说明润色是核心卖点，拉新广告全部改成主打润色。",
                "face": "frown",
                "line": "这和留存有什么关系？"
              }
            ]
          }
        },
        {
          "id": "uo1_rt_c",
          "type": "off",
          "delta": -3,
          "text": "先做一波拉新活动，把新用户量翻一倍，留下来的自然就多。",
          "face": "frown",
          "line": "留存是个比例啊。"
        },
        {
          "id": "uo1_rt_d",
          "type": "off",
          "delta": -1,
          "text": "先给流失的新用户发问卷，问清他们为什么第二天不再打开。",
          "face": "calm",
          "line": "走掉的人，有几个会填？"
        }
      ],
      "explain": "留存低，先拆：哪个渠道来的人、第一天卡在哪一步。找“关键动作”是常见思路，但用过某个功能的人留存高，可能只是因为本来就更想用的人才会去点，相关不等于因果；随机分一半新用户去引导，再比两组的留存，才能确认它真的有用。样本再大，也消除不了这种自己选出来的偏差。拉新解决不了留存率，它是个比例；给已经走掉的人发问卷，回收的往往只是少数人的看法。"
    },
    "uo1_q_retention_def": {
      "tag": "专业",
      "text": "后台有两个“次日留存”，一个 25%，一个 40%。你觉得可能差在哪？",
      "options": [
        {
          "id": "uo1_rd_a",
          "type": "safe",
          "delta": 3,
          "text": "分母可能不一样：一个按当天新增算，一个按当天活跃算。",
          "face": "nod",
          "line": "嗯，最常见的就是这个。"
        },
        {
          "id": "uo1_rd_b",
          "type": "bold",
          "text": "先对口径：分母是谁、怎么算“回来”、按哪天算。",
          "face": "probe",
          "line": "好，我先排除一个。",
          "followup": {
            "text": "分母都是当天新增的用户。还可能差在哪？",
            "options": [
              {
                "id": "uo1_rd_b1",
                "type": "hold",
                "delta": 9,
                "text": "“回来”算法不同：一个打开就算，一个要用过功能。",
                "face": "pleased",
                "line": "对，我们就是这么回事。"
              },
              {
                "id": "uo1_rd_b2",
                "type": "partial",
                "delta": -2,
                "text": "可能一个统计的是安卓，一个统计的是苹果，用户不一样。",
                "face": "calm",
                "line": "两个都是全量。"
              },
              {
                "id": "uo1_rd_b3",
                "type": "fail",
                "delta": -7,
                "text": "数据量大难免有误差，取个平均，按 32% 往上报就行。",
                "face": "frown",
                "line": "平均一下就对了？"
              }
            ]
          }
        },
        {
          "id": "uo1_rd_c",
          "type": "off",
          "delta": -3,
          "text": "次日留存就是第二天还在用的人，各家口径都差不多。",
          "face": "frown",
          "line": "那两个数怎么差这么多？"
        }
      ],
      "explain": "名字一样的指标，口径不同就是两个数。次日留存要说清三件事：分母是当天新增还是当天活跃；“回来”是打开就算，还是要完成某个动作；时间按自然日算还是满 24 小时。口径不同的两个数取平均，得到的是一个谁也解释不了的数。"
    },
    "uo1_q_dashboard": {
      "tag": "专业",
      "text": "让你给运营组搭一个每天看的数据看板，你放哪几个数？",
      "options": [
        {
          "id": "uo1_db_a",
          "type": "safe",
          "delta": 3,
          "text": "放新增、活跃、留存、付费四类，每个都能按渠道拆开。",
          "face": "nod",
          "line": "嗯，够用。"
        },
        {
          "id": "uo1_db_b",
          "type": "bold",
          "text": "先定一个北极星指标，再放三四个能解释它涨跌的数。",
          "face": "probe",
          "line": "好，那我问你。",
          "followup": {
            "text": "那我们的北极星指标，你会选什么？DAU 行不行？",
            "options": [
              {
                "id": "uo1_db_b1",
                "type": "hold",
                "delta": 9,
                "text": "选每周至少完成一次写作的用户数，比打开 App 更贴近价值。",
                "face": "pleased",
                "line": "嗯，这个我们也在讨论。"
              },
              {
                "id": "uo1_db_b2",
                "type": "partial",
                "delta": -2,
                "text": "DAU 就行，大家都看 DAU，和投资人沟通也方便。",
                "face": "calm",
                "line": "打开就走的也算？"
              },
              {
                "id": "uo1_db_b3",
                "type": "fail",
                "delta": -7,
                "text": "选累计注册用户数，它一直在涨，最能鼓舞团队。",
                "face": "frown",
                "line": "只涨不跌的数，看了有什么用？"
              }
            ]
          }
        },
        {
          "id": "uo1_db_c",
          "type": "off",
          "delta": -3,
          "text": "越全越好，能想到的几十个数都放上，出了问题一眼就能看到。",
          "face": "frown",
          "line": "五十个数，你每天看得过来？"
        },
        {
          "id": "uo1_db_d",
          "type": "off",
          "delta": -1,
          "text": "放每天的新增注册数就够了，我们现在最缺的是用户。",
          "face": "calm",
          "line": "只看新增，留不住也看不出来。"
        }
      ],
      "explain": "看板是每天要看的，少而精才有用。北极星指标要贴近用户得到的价值：写作工具里，“完成一次写作”比“打开一次”更说明问题。累计注册数只涨不跌，是典型的“好看指标”，看了做不出任何决定；只盯新增，又看不到留存在漏。"
    },
    "uo1_q_title_test": {
      "tag": "专业",
      "text": "App 推送想测两版文案，看哪版点开的人多。你怎么测？",
      "options": [
        {
          "id": "uo1_tt_a",
          "type": "safe",
          "delta": 3,
          "text": "随机分两组用户，同一时间发，只改文案，比点开率。",
          "face": "nod",
          "line": "嗯，规矩对。"
        },
        {
          "id": "uo1_tt_b",
          "type": "bold",
          "text": "先算要多少人才看得出差别，再随机分组，同时发出。",
          "face": "probe",
          "line": "好，给你个结果。",
          "followup": {
            "text": "两版各发了 2000 人，A 版点开率 5.2%，B 版 5.0%。B 可以下线了吗？",
            "options": [
              {
                "id": "uo1_tt_b1",
                "type": "hold",
                "delta": 9,
                "text": "差 0.2 个点，2000 人太少，很可能是随机波动，还不能定。",
                "face": "pleased",
                "line": "对，加样本或者再测。"
              },
              {
                "id": "uo1_tt_b2",
                "type": "partial",
                "delta": -2,
                "text": "A 高一点就用 A，反正发哪版成本都一样。",
                "face": "calm",
                "line": "下次再测，会不会反过来？"
              },
              {
                "id": "uo1_tt_b3",
                "type": "fail",
                "delta": -7,
                "text": "A 比 B 高了 4%，差得已经很明显了，可以下线 B。",
                "face": "frown",
                "line": "4%？一共才差几个人点开？"
              }
            ]
          }
        },
        {
          "id": "uo1_tt_c",
          "type": "off",
          "delta": -3,
          "text": "这周先发 A 版，下周再发 B 版，比哪周点开的多。",
          "face": "frown",
          "line": "两周的用户和时机都不一样吧？"
        }
      ],
      "explain": "测文案要随机分组、同时发出、只改一处，不然比出来的差别分不清是文案还是时机。2000 人里 5.2% 和 5.0%，只差 4 个人左右点开，在随机波动的范围内（粗算一下，这么大的差距纯靠运气出现的可能性在七成以上）。“高了 4%”是相对差，算得没错，但相对差会把很小的差别说得很大，要看的是差了多少人、显不显著。两版成本一样时先用 A 不算错，只是不能当成“A 更好”的结论写进复盘，下次再测可能就反过来了。"
    },
    "uo1_q_topic": {
      "tag": "视野与取舍",
      "text": "我们想在某图文种草平台做个账号，给 App 拉新。第一个月的选题，你怎么定？",
      "options": [
        {
          "id": "uo1_tp_a",
          "type": "safe",
          "delta": 3,
          "text": "先翻同类账号的高赞内容，挑我们能解决的痛点做选题。",
          "face": "nod",
          "line": "嗯，先看看别人怎么做。"
        },
        {
          "id": "uo1_tp_b",
          "type": "bold",
          "text": "按用户的写作场景出选题：论文、简历、周报。",
          "face": "probe",
          "line": "好，假设你发了十篇。",
          "followup": {
            "text": "十篇里，“简历改写前后对比”点赞最高，可几乎没人下载 App。怎么办？",
            "options": [
              {
                "id": "uo1_tp_b1",
                "type": "hold",
                "delta": 9,
                "text": "选题对了，断在承接：主页和评论里没给出下一步。",
                "face": "pleased",
                "line": "对，问题在后半段。"
              },
              {
                "id": "uo1_tp_b2",
                "type": "partial",
                "delta": -2,
                "text": "再多发几篇同类的，热度起来了，下载自然会跟着涨。",
                "face": "calm",
                "line": "热度已经有了。"
              },
              {
                "id": "uo1_tp_b3",
                "type": "fail",
                "delta": -7,
                "text": "每篇正文都放上下载链接和邀请码，导流越直接越好。",
                "face": "frown",
                "line": "这样发，帖子还活得过几天？"
              }
            ]
          }
        },
        {
          "id": "uo1_tp_c",
          "type": "off",
          "delta": -3,
          "text": "什么火发什么，先蹭热点把粉丝做到一万，转化以后再说。",
          "face": "frown",
          "line": "粉丝来了，和我们 App 有关系吗？"
        }
      ],
      "explain": "给产品拉新的账号，选题要从用户的使用场景和产品能解决的问题出发，而不只是追热点。点赞高、没人下载，说明内容吸引人，断在后面的承接：主页介绍、评论区回复、下一步引导到哪。很多内容平台都限制站外导流，正文里硬塞链接和邀请码，容易被限流甚至处罚，得不偿失。"
    },
    "uo1_q_priority": {
      "tag": "视野与取舍",
      "text": "我们运营人少，内容、社群、活动可能都要你管。你先做哪个？",
      "options": [
        {
          "id": "uo1_pr_a",
          "type": "safe",
          "delta": 3,
          "text": "先看现在最缺哪个数：缺新用户先做内容，留不住先做社群。",
          "face": "nod",
          "line": "嗯，看数说话。"
        },
        {
          "id": "uo1_pr_b",
          "type": "bold",
          "text": "先做社群：把最活跃的一两百个用户拉起来，听他们怎么用。",
          "face": "probe",
          "line": "好，群建起来了。",
          "followup": {
            "text": "群建了两周，每天只有几个人说话。你怎么办？",
            "options": [
              {
                "id": "uo1_pr_b1",
                "type": "hold",
                "delta": 9,
                "text": "固定发他们用得上的写作模板，再挑几个人单独聊。",
                "face": "pleased",
                "line": "嗯，先给价值。"
              },
              {
                "id": "uo1_pr_b2",
                "type": "partial",
                "delta": -2,
                "text": "每天在群里发红包、搞打卡，活跃度很快就能上来。",
                "face": "calm",
                "line": "红包停了呢？"
              },
              {
                "id": "uo1_pr_b3",
                "type": "fail",
                "delta": -7,
                "text": "人还不够多，再拉一千人进群，人一多自然就热闹了。",
                "face": "frown",
                "line": "几个人不说话，一千人就会说？"
              }
            ]
          }
        },
        {
          "id": "uo1_pr_c",
          "type": "off",
          "delta": -3,
          "text": "三样一起做，每天上午写内容、下午管社群、晚上做活动。",
          "face": "frown",
          "line": "一个人三条线，哪条都做不深。"
        }
      ],
      "explain": "资源少的时候，先找最缺的那个数，再决定做什么。用种子用户建群，是为了听到真实的使用反馈；群冷清多半不是人太少，而是群里没有他们用得上的东西。红包和打卡能把数字拉起来，一停就回去；人越拉越多、价值没跟上，群只会更快变成广告群。"
    }
  }
}
