  "nodes": {
    "uo2_q_clarify": {
      "tag": "项目表达",
      "text": "题目就这些。你可以先问问题，也可以直接出方案。",
      "options": [
        {
          "id": "uo2_cl_a",
          "type": "safe",
          "delta": 3,
          "text": "先问清目标：要注册数，还是新增付费？两种做法不一样。",
          "face": "nod",
          "line": "好问题。要付费，两周 500 个首月会员。"
        },
        {
          "id": "uo2_cl_b",
          "type": "bold",
          "text": "不问了，先出一版：邀请一个好友，送一个月会员。",
          "face": "probe",
          "line": "行，我们快进三天。",
          "followup": {
            "text": "三天邀请来 5000 人，付费的只有 30 个。问题出在哪？",
            "options": [
              {
                "id": "uo2_cl_b1",
                "type": "hold",
                "delta": 9,
                "text": "奖励就是会员，拉来的人先白用一个月，谁会付费？",
                "face": "pleased",
                "line": "对，这就是你没问的那个问题：目标是付费。"
              },
              {
                "id": "uo2_cl_b2",
                "type": "partial",
                "delta": -2,
                "text": "才三天，付费有滞后，等活动结束再看会好很多。",
                "face": "calm",
                "line": "等两周，能翻十倍吗？"
              },
              {
                "id": "uo2_cl_b3",
                "type": "fail",
                "delta": -7,
                "text": "拉新的量已经起来了就算成功，付不付费是产品那边的事。",
                "face": "frown",
                "line": "我们要的就是付费。"
              }
            ]
          }
        },
        {
          "id": "uo2_cl_c",
          "type": "off",
          "delta": -3,
          "text": "我先回去写一份完整方案，带上预算表，明天发您邮箱。",
          "face": "frown",
          "line": "现场题，我想听你现在怎么想。"
        }
      ],
      "explain": "现场做方案，第一步是问清楚：为谁做、要冲哪个数、预算能怎么花。目标是注册数还是付费用户，方案会长得完全两样；直接开做也行，但要能当场看出自己的漏洞：拿会员当奖励，拉来的人先白用一个月，正好和“新增付费”的目标对着干。说回去写完再发，面试官多半会把你拉回现场：这道题要看的就是当场的思路。"
    },
    "uo2_q_plan": {
      "tag": "专业",
      "text": "目标定了：两周新增 500 个付费用户，预算 3 万。钱你打算怎么花？",
      "options": [
        {
          "id": "uo2_pl_a",
          "type": "safe",
          "delta": 3,
          "text": "先拿 3000 块分给两三个渠道小试，跑出成本再加钱。",
          "face": "nod",
          "line": "嗯，稳。"
        },
        {
          "id": "uo2_pl_b",
          "type": "bold",
          "text": "先算账：一个付费用户最多能花多少钱，再倒推每个渠道。",
          "face": "probe",
          "line": "那你算算。",
          "followup": {
            "text": "平摊下来，一个付费用户能花 60 块。首月会员才卖 30，这账划算吗？",
            "options": [
              {
                "id": "uo2_pl_b1",
                "type": "bold",
                "text": "得看续费：一个人前后一共能付多少钱。",
                "face": "probe",
                "line": "那我给你个续费率。",
                "followup": {
                  "text": "每个月有三成的人续下个月，会员价不变。这 60 块花得值吗？",
                  "options": [
                    {
                      "id": "uo2_pl_b1a",
                      "type": "hold",
                      "delta": 12,
                      "text": "30 加 9 加 2.7……约 43 块，不到 60，只能少量试。",
                      "face": "pleased",
                      "line": "嗯，算得清，这钱就花不歪。"
                    },
                    {
                      "id": "uo2_pl_b1b",
                      "type": "partial",
                      "delta": 1,
                      "text": "毕业季正是抢人的时候，就算亏一点，先把人拉进来也值。",
                      "face": "calm",
                      "line": "今年公司要冲收支平衡。"
                    },
                    {
                      "id": "uo2_pl_b1c",
                      "type": "fail",
                      "delta": -9,
                      "text": "三成续一年，30 乘 12 再乘三成，一百多块，很值。",
                      "face": "frown",
                      "line": "第三个月还是三成？"
                    }
                  ]
                }
              },
              {
                "id": "uo2_pl_b2",
                "type": "partial",
                "delta": -2,
                "text": "不用算那么细，先跑起来，数据好了再追加预算。",
                "face": "calm",
                "line": "跑起来亏钱，你也不知道。"
              },
              {
                "id": "uo2_pl_b3",
                "type": "fail",
                "delta": -7,
                "text": "3 万全投短视频平台，量最大，500 个很快就有。",
                "face": "frown",
                "line": "全押一个渠道？"
              }
            ]
          }
        },
        {
          "id": "uo2_pl_c",
          "type": "off",
          "delta": -3,
          "text": "3 万都拿来做奖品，抽几台平板，奖品越大来的人越多。",
          "face": "frown",
          "line": "来的人多，付费的就多？"
        }
      ],
      "explain": "花预算前先算账：拉来一个付费用户最多能花多少（获客成本），要和这个用户能带来多少收入比。每月三成续费时，一个会员的收入是 30 + 9 + 2.7 + ……，加起来约 43 块，还没算 AI 调用这些成本；花 60 块买一个，规模越大亏得越多。把三成续费率当成“三成的人续满一年”，是常见的算错：留下的人是一个月比一个月少的。小钱先试、跑出成本再加钱，是不会错的做法。"
    },
    "uo2_q_mechanic": {
