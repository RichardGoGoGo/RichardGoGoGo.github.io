---
layout: null
permalink: /api/calls.json
---
{%- assign pool = site.calls | sort: "deadline", "last" -%}
{"site": {{ site.title | jsonify }}, "updated": "{{ site.time | date_to_xmlschema }}", "items": [
{%- for p in pool -%}{%- assign s = p.path | split: '/' | last | remove: '.md' -%}
{"id": {{ s | jsonify }}, "url": "{{ site.url }}/calls/#{{ s }}", "title": {{ p.title | jsonify }}, "type": {{ p.ctype | jsonify }}, "host": {{ p.host | jsonify }}, "deadline": {% if p.deadline %}"{{ p.deadline | date: '%Y-%m-%d' }}"{% else %}null{% endif %}, "src": {{ p.src | jsonify }}, "summary": {{ p.summary | jsonify }}, "tags": {{ p.tags | jsonify }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]}
